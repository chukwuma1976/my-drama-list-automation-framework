        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Check if the response status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "const body = pm.response.json();\r",
              "\r",
              "pm.test(\"Check that the title of the response is correct\", function () {\r",
              "    pm.expect(body.title).to.eql(\"The return of the Kuma\");\r",
              "});\r",
              "\r",
              "pm.test(\"Check that the slug of the response is correct\", function () {\r",
              "    pm.expect(body.slug).to.eql(\"999999-kuma-still-slick-as-a-puma\");\r",
              "});\r",
              "\r",
              "pm.test(\"Check that the body status is correct\", function () {\r",
              "    pm.expect(body.status).to.eql(\"Completed\");\r",
              "});\r",
              "\r",
              "pm.test(\"Check that the body rating is correct\", function () {\r",
              "    pm.expect(body.rating).to.eql(\"9.0\");\r",
              "});\r",
              "\r",
              "pm.test(\"Check the the body url is correct\", function () {\r",
              "    pm.expect(body.url).to.eql(\"https://mydramalist.com/999999-kuma-still-slick-as-a-puma\");\r",
              "})\r",
              "\r",
              "pm.test(\"Check that the body image is correct\", function () {\r",
              "    pm.expect(body.image).to.eql(\"https://mydramalist.com/I_make_this_look_good\");\r",
              "})\r",
              "\r",
              "pm.collectionVariables.set(\"slug\", body.slug);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
