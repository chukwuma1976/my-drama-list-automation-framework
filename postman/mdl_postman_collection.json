            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Watch status is updated to 2\", function () {\r",
              "    pm.expect(pm.response.json().watch_status).to.equal(2);\r",
              "});\r",
